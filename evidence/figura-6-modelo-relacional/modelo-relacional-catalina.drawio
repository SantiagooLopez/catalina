<mxCell id="legend" value="&lt;b&gt;Lectura del modelo físico&lt;/b&gt;&lt;br&gt;&lt;br&gt;PK: clave primaria · FK: clave foránea · ?: admite NULL&lt;br&gt;&lt;br&gt;Las cardinalidades se leen origen → destino.&lt;br&gt;&lt;br&gt;Cada versión tiene 0..1 ejecuciones activas referidas.&lt;br&gt;La FK activa no tiene restricción UNIQUE en el catálogo.&lt;br&gt;&lt;br&gt;El rol de usuario se almacena como texto obligatorio." style="rounded=1;html=1;whiteSpace=wrap;align=left;spacing=16;fillColor=#F4F7FA;strokeColor=#D5E1E9;fontColor=#315A73;fontSize=12;" vertex="1" parent="1"><mxGeometry x="45" y="1140" width="460" height="182" as="geometry"/></mxCell>
<mxCell id="footer" value="Diagrama del núcleo: se omiten tablas auxiliares de auditoría, configuración, métricas, sesiones, migraciones y fragmentos.&lt;br&gt;&lt;br&gt;Fuente: catálogo PostgreSQL del prototipo Catalina. No se modificó el esquema." style="text;html=1;strokeColor=none;fillColor=none;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;align=left;fontSize=12;fontColor=#587084;" vertex="1" parent="1"><mxGeometry x="45" y="1360" width="1020" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>