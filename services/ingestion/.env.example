APP_NAME=Catalina Ingestion Service
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8001
LOG_LEVEL=INFO

DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=catalina_db
DATABASE_USER=catalina_user
DATABASE_PASSWORD=change-me
DATABASE_MIN_POOL_SIZE=1
DATABASE_MAX_POOL_SIZE=5
DATABASE_CONNECT_TIMEOUT=10

QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=documentos_universidad
QDRANT_UPSERT_BATCH_SIZE=64
QDRANT_TIMEOUT_SECONDS=30

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=embeddinggemma:latest
OLLAMA_GENERATION_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_KEEP_ALIVE=10m

GENERATION_TEMPERATURE=0.0
GENERATION_MAX_TOKENS=512
GENERATION_RETRY_ATTEMPTS=3
GENERATION_RETRY_WAIT_SECONDS=1.0

EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=8
OLLAMA_TRUNCATE=false
EMBEDDING_RETRY_ATTEMPTS=3
EMBEDDING_RETRY_WAIT_SECONDS=1


DOCUMENTS_ROOT=/opt/catalina/documents
STAGING_DIRECTORY=/opt/catalina/documents/staging
QUARANTINE_DIRECTORY=/opt/catalina/documents/quarantine
MAX_FILE_SIZE_MB=50

ALLOWED_EXTENSIONS=[".pdf",".docx",".txt",".html",".htm"]
ALLOWED_MIME_TYPES=["application/pdf","application/vnd.openxmlformats-officedocument.wordprocessingml.document","text/plain","text/html"]

CHUNK_TARGET_SIZE=500
CHUNK_OVERLAP=80
CHUNK_MIN_SIZE=80
WORKER_POLL_SECONDS=3
WORKER_MAX_ATTEMPTS=3

